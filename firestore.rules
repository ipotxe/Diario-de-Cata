rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data, userId) {
      return data.uid is string &&
             data.uid == userId &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.email is string &&
             data.email.size() <= 150;
    }

    // Validation helper for BeerTasting
    function isValidBeerTasting(data, userId) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == userId &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 120 &&
             data.brewery is string &&
             data.brewery.size() <= 120 &&
             data.style is string &&
             data.style.size() <= 100 &&
             data.rating is number &&
             data.rating >= 0 &&
             data.rating <= 5 &&
             data.createdAt is string;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection for user's tastings
      match /tastings/{tastingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(tastingId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(tastingId) && isValidBeerTasting(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(tastingId) && isValidBeerTasting(incoming(), userId) && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(tastingId);
      }
    }
  }
}
